mod unit_3 {
    pub fn checked_add_64(a: u64, b: u64) -> Option<u64> {
    let (carry, sum): (bool, u64) = jet::add_64(a, b);
        match carry{
    false => Some(sum),
    true => None,
    }}
    pub fn safe_add_64(a: u64, b: u64) -> u64 {
    unwrap(checked_add_64(a, b))}
    pub fn checked_sub_64(a: u64, b: u64) -> Option<u64> {
    let (borrow, diff): (bool, u64) = jet::subtract_64(a, b);
        match borrow{
    false => Some(diff),
    true => None,
    }}
    pub fn safe_sub_64(a: u64, b: u64) -> u64 {
    unwrap(checked_sub_64(a, b))}
    pub fn checked_mul_64(a: u64, b: u64) -> Option<u64> {
    let result: u128 = jet::multiply_64(a, b);
        let (high, low): (u64, u64) = <u128>::into(result);
        match jet::is_zero_64(high){
    false => None,
    true => Some(low),
    }}
    pub fn safe_mul_64(a: u64, b: u64) -> u64 {
    unwrap(checked_mul_64(a, b))}
    pub fn checked_div_64(a: u64, b: u64) -> Option<u64> {
    match jet::is_zero_64(b){
    false => Some(jet::divide_64(a, b)),
    true => None,
    }}
    pub fn safe_div_64(a: u64, b: u64) -> u64 {
    unwrap(checked_div_64(a, b))}
    pub fn gt_64(a: u64, b: u64) -> bool {
    jet::lt_64(b, a)}
    pub fn ge_64(a: u64, b: u64) -> bool {
    jet::le_64(b, a)}
}
mod unit_7 {
    pub fn not(bit: bool) -> bool {
    <u1>::into(jet::complement_1(<bool>::into(bit)))}
    pub fn or(a: bool, b: bool) -> bool {
    <u1>::into(jet::or_1(<bool>::into(a), <bool>::into(b)))}
    pub fn and(a: bool, b: bool) -> bool {
    <u1>::into(jet::and_1(<bool>::into(a), <bool>::into(b)))}
    pub fn xor(a: bool, b: bool) -> bool {
    and(or(a, b), not(and(a, b)))}
}
mod unit_6 {
    use crate::unit_7::and;
    pub fn and_128(a: u128, b: u128) -> u128 {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        <(u64, u64)>::into((jet::and_64(a_high, b_high), jet::and_64(a_low, b_low)))}
    pub fn or_128(a: u128, b: u128) -> u128 {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        <(u64, u64)>::into((jet::or_64(a_high, b_high), jet::or_64(a_low, b_low)))}
    pub fn eq_128(a: u128, b: u128) -> bool {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        and(jet::eq_64(a_high, b_high), jet::eq_64(a_low, b_low))}
    pub fn left_shift_128(shift: u8, a: u128) -> u128 {
    match jet::is_zero_8(shift){
    false => {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        match jet::lt_8(shift, 64){
    false => {
    let (_, shift): (bool, u8) = jet::subtract_8(shift, 64);
        <(u64, u64)>::into((jet::left_shift_64(shift, a_low), 0))}
    ,
    true => {
    let (_, low_to_high_amount): (bool, u8) = jet::subtract_8(64, shift);
        let shifted_bits: u64 = jet::right_shift_64(low_to_high_amount, a_low);
        let res_high: u64 = jet::or_64(jet::left_shift_64(shift, a_high), shifted_bits);
        <(u64, u64)>::into((res_high, jet::left_shift_64(shift, a_low)))}
    ,
    }}
    ,
    true => a,
    }}
    pub fn right_shift_128(shift: u8, a: u128) -> u128 {
    match jet::is_zero_8(shift){
    false => {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        match jet::lt_8(shift, 64){
    false => {
    let (_, shift): (bool, u8) = jet::subtract_8(shift, 64);
        <(u64, u64)>::into((0, jet::right_shift_64(shift, a_high)))}
    ,
    true => {
    let (_, high_to_low_amount): (bool, u8) = jet::subtract_8(64, shift);
        let shifted_bits: u64 = jet::left_shift_64(high_to_low_amount, a_high);
        let res_low: u64 = jet::or_64(jet::right_shift_64(shift, a_low), shifted_bits);
        <(u64, u64)>::into((jet::right_shift_64(shift, a_high), res_low))}
    ,
    }}
    ,
    true => a,
    }}
}
