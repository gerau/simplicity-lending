        let (output_asset_bits, output_amount): (u256, u64) = get_output_explicit_asset_and_amount(output_index);
        check_assets_eq(input_asset_bits, expected_asset_bits);
        check_assets_eq(input_asset_bits, output_asset_bits);
        (input_amount, output_amount)}
    pub fn ensure_io_asset_and_amount_eq(input_index: u32, output_index: u32, expected_asset_bits: u256, expected_amount: u64) {
    let (input_amount, output_amount): (u64, u64) = ensure_io_asset_eq(input_index, output_index, expected_asset_bits);
        check_asset_amounts_eq(input_amount, expected_amount);
        check_asset_amounts_eq(input_amount, output_amount);
    }
    pub fn ensure_input_asset_and_amount_burn(input_index: u32, output_index: u32, expected_asset_bits: u256, expected_asset_amount: u64) {
