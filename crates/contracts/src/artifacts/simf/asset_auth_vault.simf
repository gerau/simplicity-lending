        withdraw_part(input_keeper_index, output_keeper_index, vault_output_index, already_supplied, amount_to_withdraw);
    }
    ,
    }}
    ,
    Right(supply_params: Either<(u32, u32, u32, u64, u64), (u32, u32, u32, u64)>) => {
    match supply_params{
    Left(supply_params: (u32, u32, u32, u64, u64)) => {
    let (input_supplier_index, output_supplier_index, vault_output_index, already_supplied, amount_to_supply): (u32, u32, u32, u64, u64) = supply_params;
        supply(input_supplier_index, output_supplier_index, vault_output_index, already_supplied, amount_to_supply);
    }
    ,
    Right(final_supply_params: (u32, u32, u32, u64)) => {
    let (input_supplier_index, output_supplier_index, finalized_vault_output_index, already_supplied): (u32, u32, u32, u64) = final_supply_params;
        final_supply(input_supplier_index, output_supplier_index, finalized_vault_output_index, already_supplied);
    }
    ,
    }}
    ,
    }}
}
