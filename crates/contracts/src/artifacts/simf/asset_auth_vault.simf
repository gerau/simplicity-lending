    let is_active_slot_leaf: u256 = get_bool_slot_leaf(is_active);
        let already_supplied_slot_leaf: u256 = get_u64_slot_leaf(already_supplied);
        let first_tap_node: u256 = jet::build_tapbranch(jet::tapleaf_hash(), is_active_slot_leaf);
        let tap_node: u256 = jet::build_tapbranch(first_tap_node, already_supplied_slot_leaf);
        get_script_hash_from_tap_node(tap_node)}
    fn auth_with_burn_check(input_asset_index: u32, output_asset_index: u32, expected_asset_id: u256, with_asset_burn: bool) {
