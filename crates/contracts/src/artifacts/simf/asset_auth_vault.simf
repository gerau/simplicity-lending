    <u64>::into(a)}
    pub fn safe_u64_to_u1(a: u64) -> u1 {
    let u1_max: u64 = jet::left_pad_low_1_64(jet::high_1());
        assert!(jet::le_64(a, u1_max));
        jet::rightmost_64_1(a)}
    pub fn safe_u64_to_u8(a: u64) -> u8 {
